# --- Employee invitation email (add to your .env) ---
FRONTEND_BASE_URL=http://localhost:5173   # public URL of the site; used in the activation link
INVITE_TTL_HOURS=48                       # activation link lifetime
COMPANY_NAME=BUSSOLOGIC
# Any SMTP provider. Gmail: smtp.gmail.com / 587 with a Google *App Password* (2FA required).
# SendGrid: smtp.sendgrid.net / 587, user "apikey", pass = API key. Brevo: smtp-relay.brevo.com / 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                         # true for port 465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BUSSOLOGIC <no-reply@yourdomain.com>"

# --- Two separate apps, one shared MongoDB (use the SAME MONGODB_URI / MONGODB_DB in both) ---
# Manager Portal (this project, API :8000, UI :5173):
PORTAL_MODE=manager
EMPLOYEE_PORTAL_URL=http://localhost:5174   # activation links in invitation emails point to the Employee Portal
# Employee Portal (bisso_project, API :8001, UI :5174) uses PORTAL_MODE=employee and the same MONGODB_* and SMTP settings.
# Resume parsing: optional `npm i pdf-parse mammoth` for PDF/DOCX; set BUILT_IN_FORGE_API_KEY to enable LLM refinement.
